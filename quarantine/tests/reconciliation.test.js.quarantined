'use strict';

/**
 * Phase 58 - Legacy P2P -> authoritative project reconciliation.
 * STATIC, NON-MUTATING, NO-DB verification of the reconciliation contract.
 *
 * This test file NEVER:
 *   - connects to a pool, mints a JWT, runs an EXPERT the audit cannot fail
 *   - opens a transaction, calls reconcileLegacyProject(), or touches any DB
 *   - claims ACCEPTANCE or runs live reconciliation
 *
 * It proves, purely by reading the committed reconciliation service +
 * bridge migration source, that the delivered code honors the Phase-58
 * reconciliation invariant:  legacy funding is RE-REGISTERED as history,
 * never RE-INVESTED.  Zero wallet/funding/workflow mutation.
 *
 * Run:  node tests/reconciliation.test.js          (static-only, safe)
 */

const fs = require('fs');
const path = require('path');

const ROOT = path.resolve(__dirname, '..');
const SERVICE = path.join(ROOT, 'src', 'services', 'projectReconciliationService.js');
const MIGRATION = path.join(ROOT, 'db', 'migrations', '138_legacy_p2p_reconciliation_bridge.sql');

const tests = [];
function test(name, fn) { tests.push({ name, fn }); }

function read(f) { return fs.readFileSync(f, 'utf8'); }
function assert(c, m) { if (!c) throw new Error(m || 'assertion failed'); }

// --- 1) ASCII hygiene (zero bytes >= 0x80 in delivered source) ---
['src/services/projectReconciliationService.js', 'db/migrations/138_legacy_p2p_reconciliation_bridge.sql', 'tests/reconciliation.test.js'].forEach((rel) => {
  const p = path.join(ROOT, rel);
  test(`${rel} is pure ASCII (no non-ASCII bytes)`, () => {
    const buf = fs.readFileSync(p);
    for (let i = 0; i < buf.length; i++) {
      if (buf[i] >= 0x80) throw new Error('non-ASCII byte at offset ' + i);
    }
  });
});

// --- AST-aware tokenizer: strips comments + all string/template literals so that
// documentation examples and docblock mentions are NOT treated as executable code.
// Only genuine CallExpression call-sites (identifier directly followed by '(')
// and identifier references outside strings/comments are considered.
function toTokens(src) {
  const out = [];
  const n = src.length;
  let i = 0;
  const isIdStart = (c) => /[A-Za-z_$]/.test(c);
  const isIdChar = (c) => /[A-Za-z0-9_$]/.test(c);
  while (i < n) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }
    if (c === '/' && src[i + 1] === '/') {
      while (i < n && src[i] !== '\n') i++;
      out.push({ type: 'comment' });
      continue;
    }
    if (c === '/' && src[i + 1] === '*') {
      i += 2;
      while (i < n && !(src[i] === '*' && src[i + 1] === '/')) i++;
      i += 2;
      out.push({ type: 'comment' });
      continue;
    }
    if (c === '"' || c === "'" || c === '`') {
      const q = c;
      i++;
      while (i < n) {
        if (src[i] === '\\') { i += 2; continue; }
        if (q === '`' && src[i] === '$' && src[i + 1] === '{') {
          let depth = 1; i += 2;
          while (i < n && depth > 0) {
            if (src[i] === '{') depth++;
            if (src[i] === '}') depth--;
            i++;
          }
          continue;
        }
        if (src[i] === q) { i++; break; }
        i++;
      }
      out.push({ type: 'str' });
      continue;
    }
    if (isIdStart(c)) {
      let j = i;
      while (j < n && isIdChar(src[j])) j++;
      out.push({ type: 'id', value: src.slice(i, j) });
      i = j;
      continue;
    }
    out.push({ type: 'punct', value: c });
    i++;
  }
  return out;
}

// True call-sites: id token directly followed by '(' punct (skipping only
// whitespace/comments which the lexer already dropped).
function callSites(tokens) {
  const calls = [];
  for (let k = 0; k + 1 < tokens.length; k++) {
    if (tokens[k].type === 'id' && tokens[k + 1].type === 'punct' && tokens[k + 1].value === '(') {
      calls.push(tokens[k].value);
    }
  }
  return calls;
}

function idSet(tokens) {
  const set = new Set();
  for (const t of tokens) if (t.type === 'id') set.add(t.value);
  return set;
}

// --- 2) Reconciliation-domain invariants held by the REAL service source ---
test('service does NOT replay the funding workflow (no forbidden API call-sites)', () => {
  const tokens = toTokens(read(SERVICE));
  const sites = callSites(tokens);
  const forbidden = [
    'invest', 'acceptAgreement', 'payConsultationFee', 'debitWallet',
    'submitProject', 'makeWorkflowDecision', 'makeDecision', 'publishProject',
  ];
  const hit = sites.filter((s) => forbidden.includes(s));
  assert(hit.length === 0, 'forbidden funding call-site found in service: ' + hit.join(', '));
});

test('service does NOT create a financial_operations / financial_journal write', () => {
  const tokens = toTokens(read(SERVICE));
  const ids = idSet(tokens);
  const seams = ['financial_operations', 'financial_journal'];
  const hit = seams.filter((s) => ids.has(s));
  assert(hit.length === 0, 'financial mutation identifier used in executable code: ' + hit.join(', '));
});

test('service preserves historical data_availability and NO_RECORDS (never fabricates cohort)', () => {
  const tokens = toTokens(read(SERVICE));
  const ids = idSet(tokens);
  assert(ids.has('data_availability'), 'data_availability identifier not surfaced');
  assert(ids.has('NO_RECORDS'), 'NO_RECORDS identifier not surfaced');
  assert(ids.has('AVAILABLE'), 'AVAILABLE identifier not surfaced');
  assert(!ids.has('cohort') && !ids.has('Cohort'), 'fabricated cohort detected');
});

test('bridge migration is idempotent (authoritative_project_id IF NOT EXISTS)', () => {
  const mig = read(MIGRATION);
  assert(mig.includes('authoritative_project_id'), 'bridge column absent');
  assert(mig.includes('IF NOT EXISTS') || mig.includes('IF EXISTS'), 'no idempotency guard');
});

test('bridge targets the REAL server column name (investment_projects)', () => {
  const mig = read(MIGRATION);
  assert(mig.includes('investment_projects'), 'not targeting legacy table');
  assert(mig.includes('projects(') || mig.includes('REFERENCES projects'), 'no FK to authoritative projects');
});

let passed = 0, failed = 0;
for (const t of tests) {
  try { t.fn(); passed++; console.log('PASS  ' + t.name); }
  catch (e) { failed++; console.log('FAIL  ' + t.name + ' -> ' + e.message); }
}
console.log(`\nreconciliation-static: ${passed} passed, ${failed} failed`);
process.exit(failed ? 1 : 0);
