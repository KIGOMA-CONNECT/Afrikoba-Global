# Afrikoba Global Environment Template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# For production, prefer a Secrets Manager (HashiCorp Vault / AWS Secrets Manager) over .env

# ---- Server ----
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# ---- Database (PostgreSQL) ----
# MIGRATE: move these to a secrets manager in production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afrikoba
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=20

# ---- Security (JWT) ----
# GENERATE: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_64_hex_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=changeme

# ---- CORS (comma-separated) ----
CORS_ORIGINS=*
ALLOWED_ORIGINS=*

# ---- Rate limiting ----
RATE_LIMIT_DISABLED=false
# Use Redis for distributed rate limiting across instances
REDIS_URL=
USE_REDIS=false

# ---- SMS / OTP provider (Beem) ----
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=

# ---- Payment gateway (Azampay) ----
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=

# ---- Encryption / HSM (sensitive) ----
ENCRYPTION_KEY=changeme
WALLET_ENCRYPTION_KEY=changeme

# ---- Contracts ----
CONTRACT_DIR=contracts

# ---- Security scanning CI (used by GitHub Actions only) ----
# Add these as GitHub repository secrets, NOT in .env:
# SERVER_HOST, SERVER_USER, SSH_PRIVATE_KEY

# ---- Observability ----
# Enable OpenTelemetry tracing (Jaeger / Grafana Tempo / Honeycomb)
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Sentry (production)
SENTRY_DSN=