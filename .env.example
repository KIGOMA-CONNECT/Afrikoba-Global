# ==========================================
# SERVER
# ==========================================
NODE_ENV=production
PORT=3000
# Host port ya API inaonekana kwenye 127.0.0.1 pekee (reverse proxy!) -
# badilisha tu kama 3000 inatumiwa na app nyingine (domain nyingine) kwenye
# server hii. Haifunguki kwa nje moja kwa moja.
APP_PORT=3000
# Jina la Docker project. Usibadili kwa componenet nyingi za Afrikoba
# (staging/prod) kwenye server moja. Kila project ina network+volumes zake.
COMPOSE_PROJECT_NAME=afrikoba
# Directory ya DB backups (host path - badilisha kuwa zile za S3/R2 drive mwisho)
BACKUP_DIR=./backups
# Weka 'true' kama iko nyuma ya reverse proxy / load balancer
TRUST_PROXY=true

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=afrikoba
DB_PASSWORD=change_me_strong_password
DB_NAME=afrikoba_global

# ==========================================
# BEEM AFRICA SMS API (Tanzania - OTP ndani ya TZ)
# ==========================================
BEEM_API_KEY=your_beem_api_key_here
BEEM_SECRET_KEY=your_beem_secret_key_here
BEEM_SENDER_ID=AFRIKOBA

# ==========================================
# AFRICA'S TALKING SMS API (Afrika Mashariki/Kati/Magharibi - OTP kimataifa)
# Inatumika auto kwa: KE, UG, RW, BI, ZM, MW, MZ, ET, SO, CD, GH, NG, ZA, EG
# Register: https://account.africastalking.com/status
# ==========================================
AT_API_KEY=your_africastalking_production_api_key_here
AT_USERNAME=your_africastalking_username
# Sender ID lazima uregistre kwenye AT (alphanumeric au short code). Acha tupu kama huna.
AT_SENDER_ID=AFRIKOBA

# ==========================================
# TWILIO SMS API (Dunia - default/failover kwa nchi zisizo kwenye routed ya AT)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+15005550006

# ==========================================
# AZAMPAY CHECKOUT API (halisi - inahitajika kwa deposit/withdrawal)
# ==========================================
AZAMPAY_APP_NAME=your_app_name
AZAMPAY_CLIENT_ID=your_client_id_guid
AZAMPAY_CLIENT_SECRET=your_client_secret_here
# IMPORTANT: lazima iwe 'production' kabla ya kuanza kwa usalama
AZAMPAY_ENV=production

# ==========================================
# WEBHOOK SECURITY (callbacks za AzamPay)
# ==========================================
WEBHOOK_SECRET=change_me_super_secret
ALLOWED_WEBHOOK_IPS=102.223.0.1,41.59.0.1

# ==========================================
# USSD GATEWAY SECURITY
# ==========================================
# HMAC-SHA256 signature key for USSD gateway requests
# In production, set to a strong random secret
# USSD_SECRET=change_me_ussd_secret

# ==========================================
# AUTH / JWT
# ==========================================
# Tengeneza: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_48_char_random_hex
JWT_TTL=7d

# ==========================================
# CORS - origins halisi zinazoruhusiwa (sio '*' katika production)
# ==========================================
CORS_ORIGINS=https://app.afrikoba.com,https://admin.afrikoba.com

# ==========================================
# RATE LIMITING
# ==========================================
# RATE_LIMIT_DISABLED=true kwa tests/CI tu
RATE_LIMIT_DISABLED=false
OTP_RATE_MAX=20
AUTH_RATE_MAX=40
API_RATE_MAX=1000
RATE_WINDOW_MS=900000

# ==========================================
# PLATFORM FEE CONFIG
# ==========================================
DEPOSIT_COMMISSION_PERCENT=0.01
PLATFORM_COMM_PERCENT=2.00
INVESTOR_PAYOUT_PERCENT=28.00
OPERATIONAL_PERCENT=70.00
VICOBA_MONTHLY_FEE=10000.00

# ==========================================
# CONTRACTS / PDF
# ==========================================
CONTRACT_DIR=contracts
CONTRACT_BASE_URL=https://app.afrikoba.com/contracts

# ==========================================
# TLS (optional - reverse proxy kama Nginx/Caddy inapendekezwa)
# ==========================================
# TLS_CERT_PATH=./certs/fullchain.pem
# TLS_KEY_PATH=./certs/privkey.pem

# ==========================================
# SENTRY (optional - error monitoring)
# ==========================================
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# REDIS (optional - required for multi-replica)
# ==========================================
# REDIS_URL=redis://localhost:6379
